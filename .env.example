# true 면 전부 MSW 목업, auth 면 로그인(과 찜)만 목업이고 유기견 데이터는 실제 백엔드, false 면 전부 실제 백엔드
VITE_ENABLE_MOCK=false
VITE_API_BASE_URL=/api
# 개발 서버 프록시가 넘길 백엔드 주소 (vite.config.ts)
API_PROXY_TARGET=https://api.lovablepet.tech
# 카카오 로그인 (키는 카카오 개발자 콘솔에서 발급)
VITE_KAKAO_REST_KEY=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao
