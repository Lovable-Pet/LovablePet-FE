# pnpm build (배포) 에서 쓰는 값. 프론트(lovablepet.tech)가 API(api.lovablepet.tech)를 직접 부른다
# 백엔드 CORS_ALLOWED_ORIGINS 에 프론트 주소가 있어야 한다
VITE_ENABLE_MOCK=false
VITE_API_BASE_URL=https://api.lovablepet.tech/api
# 카카오 로그인 후 돌아올 주소. 백엔드 KAKAO_REDIRECT_URI 와 카카오 개발자 콘솔 Redirect URI 도 같은 값이어야 한다
VITE_KAKAO_REDIRECT_URI=https://lovablepet.tech/oauth/kakao
# VITE_KAKAO_REST_KEY 는 커밋하지 않는다. 배포 환경 변수나 .env.production.local 에 넣는다
