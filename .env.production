# pnpm build (배포) 에서 쓰는 값. 프론트(버셀 https://lovablepet-fe.vercel.app)가 API(api.lovablepet.tech)를 직접 부른다
# lovablepet.tech 도메인을 버셀에 연결하면 아래 주소와 백엔드 설정을 같이 바꾼다
# 백엔드 CORS_ALLOWED_ORIGINS 에 프론트 주소가 있어야 한다
VITE_ENABLE_MOCK=false
VITE_API_BASE_URL=https://api.lovablepet.tech/api
# 카카오 로그인 후 돌아올 주소. 백엔드 KAKAO_REDIRECT_URI 와 카카오 개발자 콘솔 Redirect URI 도 같은 값이어야 한다
VITE_KAKAO_REDIRECT_URI=https://lovablepet-fe.vercel.app/oauth/kakao
# VITE_KAKAO_REST_KEY 는 커밋하지 않는다. 버셀 프로젝트 환경 변수(Production)에 넣어 뒀다
